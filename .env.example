PORT=7005

# ---- MongoDB (LecAI와 동일 서버) ----
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=eng2mouth
MONGO_USERNAME=your_value_here
MONGO_PASSWORD=your_value_here

# ---- 세션/메일 ----
SECRET_KEY=your_value_here
MAIL_SENDER=your_value_here
MAIL_PASSWORD=your_value_here
# 회원가입 시 이메일 인증 요구 (메일 설정이 없으면 자동으로 건너뜀)
SIGNUP_REQUIRE_EMAIL=true

# ---- OpenAI 모델 (사용자별 API Key 사용) ----
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_MINI_MODEL=gpt-realtime-2.1-mini
TRANSCRIBE_MODEL=gpt-4o-transcribe
CHAT_MODEL=gpt-5.6-luna
TTS_MODEL=gpt-4o-mini-tts
DEFAULT_VOICE=marin

# ---- Google Gemini (사용자별 API Key, 통화 시 제공자 선택) ----
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_DEFAULT_VOICE=Aoede
GEMINI_ALLOW_DIRECT_KEY=false
